generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TrackType {
  LLD
  HLD
}

enum ModuleType {
  LESSON
  DESIGN_QUESTION
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SubmissionStatus {
  PENDING
  EVALUATING
  PASSED
  FAILED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  enrollments Enrollment[]
  submissions Submission[]
  progress    Progress[]
  stats       UserStats?
  feedbacks   Feedback[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Curriculum ───────────────────────────────────────────────────────────────

model Track {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String
  type        TrackType
  order       Int

  modules     Module[]
  enrollments Enrollment[]
}

model Module {
  id           String     @id @default(cuid())
  trackId      String
  slug         String
  title        String
  description  String
  order        Int
  type         ModuleType
  difficulty   Difficulty
  isLocked     Boolean    @default(false)

  track     Track            @relation(fields: [trackId], references: [id])
  lessons   Lesson[]
  questions DesignQuestion[]

  @@unique([trackId, slug])
}

model Lesson {
  id           String @id @default(cuid())
  moduleId     String
  title        String
  contentJson  Json
  order        Int
  xpReward     Int    @default(10)
  estimatedMin Int    @default(10)

  module Module @relation(fields: [moduleId], references: [id])
}

model DesignQuestion {
  id           String     @id @default(cuid())
  moduleId     String
  title        String
  description  String     @db.Text
  track        TrackType
  difficulty   Difficulty
  estimatedMin Int        @default(60)
  tags         String[]
  xpTotal      Int        @default(150)

  module      Module       @relation(fields: [moduleId], references: [id])
  phases      Phase[]
  submissions Submission[]
  progress    Progress[]
}

model Phase {
  id            String @id @default(cuid())
  questionId    String
  order         Int
  title         String
  instruction   String @db.Text
  systemPrompt  String @db.Text
  rubricJson    Json
  passThreshold Int    @default(60)
  maxAttempts   Int    @default(4)
  xpReward      Int    @default(25)
  editorType    String @default("richtext")
  walkthroughText String? @db.Text   // Shown when attempts are exhausted
  question    DesignQuestion @relation(fields: [questionId], references: [id])
  submissions Submission[]

  @@unique([questionId, order])
}

// ─── Submissions & Evaluation ─────────────────────────────────────────────────

model Submission {
  id            String           @id @default(cuid())
  userId        String
  questionId    String
  phaseId       String
  content       String           @db.Text
  attemptNumber Int              @default(1)
  status        SubmissionStatus @default(PENDING)
  createdAt     DateTime         @default(now())

  user       User           @relation(fields: [userId], references: [id])
  question   DesignQuestion @relation(fields: [questionId], references: [id])
  phase      Phase          @relation(fields: [phaseId], references: [id])
  evaluation Evaluation?
}

model Evaluation {
  id               String   @id @default(cuid())
  submissionId     String   @unique
  score            Int
  pass             Boolean
  strengths        String[]
  missingElements  String[]
  misconceptions   String[]
  targetedFeedback String   @db.Text
  hint             String?  @db.Text
  nextPhaseTeaser  String?
  modelUsed        String
  evaluationMs     Int
  createdAt        DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id])
}

// ─── Progress ─────────────────────────────────────────────────────────────────

model Progress {
  id              String         @id @default(cuid())
  userId          String
  questionId      String
  currentPhase    Int            @default(1)
  completedPhases  Int[]
  exhaustedPhases  Int[]          // Phases passed by force after exhausting attempts
  status           ProgressStatus @default(NOT_STARTED)
  totalXp         Int            @default(0)
  startedAt       DateTime       @default(now())
  completedAt     DateTime?

  user     User           @relation(fields: [userId], references: [id])
  question DesignQuestion @relation(fields: [questionId], references: [id])

  @@unique([userId, questionId])
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  startedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  track Track @relation(fields: [trackId], references: [id])

  @@unique([userId, trackId])
}

// ─── Gamification ────────────────────────────────────────────────────────────

model UserStats {
  id            String   @id @default(cuid())
  userId        String   @unique
  totalXp       Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveAt  DateTime @default(now())
  lldCompleted  Int      @default(0)
  hldCompleted  Int      @default(0)
  badges        String[]

  user User @relation(fields: [userId], references: [id])
}

// ─── Feedback ────────────────────────────────────────────────────────────────

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  rating    Int      // 1–5 stars
  category  String   // "bug" | "suggestion" | "praise" | "content"
  message   String   @db.Text
  page      String?  // URL path where feedback was submitted
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
